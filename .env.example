# Copy this file to .env and fill in values. Never commit .env.
# Every value below has a safe default; the app runs with an empty .env.

# ---------------------------------------------------------------------------
# Optional model. Leave OPENAI_API_KEY empty to run the grounded extractive
# engine only. With a key, the model proposes scores and quotes; the action
# policy stays in code either way, and ungrounded claims are still capped.
# Works with any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_RETRIES=1

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/packet_review.db
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Operator safety switches
# ---------------------------------------------------------------------------
# Required if APP_HOST is anything other than loopback. Without it, anyone who
# can reach the port can read stored candidate reviews. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Largest resume PDF accepted by the upload form, in bytes (default 8 MB).
MAX_UPLOAD_BYTES=8000000

# Job-URL fetching refuses private, loopback and cloud-metadata addresses.
# Only the evaluation fixtures need this on; leave it false in real use.
ALLOW_PRIVATE_JOB_URLS=false
